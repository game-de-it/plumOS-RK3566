+static long rg353m_runtime_volume(long fallback) {
+  const char *root = getenv("PLUMOS_RUNTIME_ROOT");
+  char path[PATH_MAX];
+  char buffer[32];
+  char *end;
+  long volume;
+
+  if (!root || !join_path(path, sizeof(path), root, "volume/current") ||
+      !read_first_line_file(path, buffer, sizeof(buffer))) {
+    return fallback;
+  }
+  volume = strtol(buffer, &end, 10);
+  return end != buffer && *end == '\0' && volume >= 0 &&
+         volume <= PLUMOS_VOLUME_MAX ? volume : fallback;
+}
