+static int save_system_config_literal(struct ui_state *ui, const char *key,
+                                      const char *value) {
+  char path[PATH_MAX];
+  int fd;
+  int saved;
+
+  if (!runtime_device_is_rg353m()) {
+    return replace_json_key_value_atomic(ui->system_config_path, key, value);
+  }
+  if (snprintf(path, sizeof(path), "%s.lock", ui->system_config_path) >=
+      (int)sizeof(path)) {
+    return 0;
+  }
+  fd = open(path, O_CREAT | O_RDWR | O_CLOEXEC, 0644);
+  if (fd < 0) {
+    return 0;
+  }
+  saved = flock(fd, LOCK_EX) == 0 &&
+          replace_json_key_value_atomic(ui->system_config_path, key, value);
+  close(fd);
+  return saved;
+}
