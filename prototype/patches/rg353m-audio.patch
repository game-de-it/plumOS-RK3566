+# The USB Audio driver publishes usbid for each USB ALSA card. Select
+# playback-capable interfaces only, including devices with capture endpoints.
+find_usb_playback() {
+    for pcm in "${PLUMOS_SOUND_SYSFS:-/sys/class/sound}"/pcmC*D*p; do
+        [ -e "$pcm" ] || continue
+        address=${pcm##*/pcmC}
+        usb_card=${address%%D*}
+        usb_device=${address#*D}
+        usb_device=${usb_device%p}
+        case "$usb_card:$usb_device" in
+            :*|*:|*[!0-9:]*) continue ;;
+        esac
+        [ -r "${PLUMOS_PROC_ASOUND:-/proc/asound}/card$usb_card/usbid" ] || continue
+        [ -c "${PLUMOS_SOUND_DEVICES:-/dev/snd}/${pcm##*/}" ] || continue
+        card=$usb_card
+        device=$usb_device
+        mode=usb_dac
+        id=$(cat "${PLUMOS_SOUND_SYSFS:-/sys/class/sound}/card$card/id" 2>/dev/null || printf 'USB')
+        return 0
+    done
+    return 1
+}
