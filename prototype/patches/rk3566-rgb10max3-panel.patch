+static int plumos_fbdev_rgb10max3(void) {
+  char model[64] = {0};
+  FILE *file = fopen("/proc/device-tree/model", "rb");
+  if (!file) {
+    return 0;
+  }
+  (void)fread(model, 1, sizeof(model) - 1, file);
+  fclose(file);
+  return strcasecmp(model, "Powkiddy RGB10 Max 3") == 0 ||
+         strcasecmp(model, "Powkiddy RGB10MAX3") == 0;
+}
+
+/* A landscape pixel (x, y) goes to (y, width - 1 - x) on the
+ * portrait scanout. Tile the transpose to keep both strides cache-local. */
+static void plumos_fbdev_drm_rotate_left(uint32_t *dst, size_t dst_stride,
+                                        const uint32_t *src, size_t width,
+                                        size_t height) {
+  const size_t tile = 16;
+  for (size_t top = 0; top < height; top += tile) {
+    for (size_t left = 0; left < width; left += tile) {
+      size_t end_y = top + tile < height ? top + tile : height;
+      size_t end_x = left + tile < width ? left + tile : width;
+      for (size_t x = left; x < end_x; ++x) {
+        uint32_t *row = dst + (width - 1 - x) * dst_stride;
+        for (size_t y = top; y < end_y; ++y) {
+          row[y] = src[y * width + x];
+        }
+      }
+    }
+  }
+}
