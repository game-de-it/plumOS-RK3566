+/* The daemon listens alongside the FE or game without grabbing the gamepad. */
+static int read_brightness_keys(int fd, int *start_held) {
+  struct input_event event;
+  ssize_t bytes;
+
+  while ((bytes = read(fd, &event, sizeof(event))) == (ssize_t)sizeof(event)) {
+    if (event.type == EV_SYN && event.code == SYN_DROPPED) {
+      *start_held = 0;
+    } else if (event.type == EV_KEY && event.code == BTN_START) {
+      *start_held = event.value != 0;
+    } else if (*start_held && event.type == EV_KEY && event.value == 1 &&
+               (event.code == BTN_DPAD_LEFT || event.code == BTN_DPAD_RIGHT)) {
+      const char *action = event.code == BTN_DPAD_RIGHT ? "up" : "down";
+      int result = run_control_helper("plumos-display-control", action);
+      fprintf(stderr, "brightness-keys: action=%s rc=%d\n", action, result);
+    }
+  }
+  return bytes < 0 && (errno == EAGAIN || errno == EINTR);
 }

