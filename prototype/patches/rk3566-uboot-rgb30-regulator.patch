 #define MAX_TFTP_PATH_LEN 127
+
+static const char *pxe_board_fdtfile(const char *name)
+{
+#if defined(CONFIG_ROCKCHIP_RK3568) && defined(CONFIG_DM_I2C)
+	struct udevice *bus, *chip;
+
+	/* The resource DTB already selected by ADC exposes the RGB30 I2C bus.
+	 * Both regulator variants share that board ID. */
+	if (!name || strcmp(name, "rk3566-rgb30-linux.dtb"))
+		return name;
+
+	if (uclass_get_device_by_name(UCLASS_I2C, "i2c@fdd40000", &bus))
+		goto unknown;
+
+	/* Read from the regulator without changing its voltage registers. */
+	if (!i2c_get_chip(bus, 0x1c, 1, &chip) && dm_i2c_reg_read(chip, 0x03) >= 0) {
+		puts("RGB30 CPU regulator: TCS452x\n");
+		return name;
+	}
+	if (!i2c_get_chip(bus, 0x40, 1, &chip) && dm_i2c_reg_read(chip, 0x03) == 0x88) {
+		puts("RGB30 CPU regulator: FAN53555\n");
+		return "rk3566-rgb30r2-linux.dtb";
+	}
+
+unknown:
+	puts("RGB30 CPU regulator: detection unavailable, using JELOS DTB\n");
+#endif
+	return name;
+}

