#!/usr/bin/busybox sh
# Supervise the RG353M frontend and recovery transport as PID 1.
export PATH=/usr/sbin:/usr/bin:/sbin:/bin HOME=/storage
payload=/usr/lib/plumos-353m
runtime=/run/plumos-353m
storage=/storage/plumos-rk3566
system_state=$storage/system
: > /dev/plumos-native-init
sd2_service=$payload/manage-sd2
quiesce=$payload/runtime-quiesce
export PLUMOS_ROOT=$storage/frontend
export XDG_RUNTIME_DIR=$runtime
export PLUMOS_RUNTIME_ROOT=$runtime PLUMOS_SDCARD_ROOT=/storage/user

for directory in /run /tmp; do
    grep -qs " $directory " /proc/mounts || mount -t tmpfs tmpfs "$directory"
done
mkdir -p "$runtime" /dev/pts /dev/shm
chmod 700 "$runtime"
grep -qs ' /dev/pts ' /proc/mounts || mount -t devpts -o mode=620,ptmxmode=0666 devpts /dev/pts
exec >>"$runtime/init.log" 2>&1
grep -qs ' /dev/shm ' /proc/mounts || mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /dev/shm
mkdir -p /run/udev
busybox mdev -s
printf '%s\n' "$$" > "$runtime/pid1"
cut -d ' ' -f 1 /proc/uptime > "$runtime/pid1-uptime"
printf 'plumOS init: PID %s; inherited boot arguments: %s\n' "$$" "$*"

for online in /sys/devices/system/cpu/cpu[0-9]*/online; do
    [ -w "$online" ] && [ "$(cat "$online")" = 0 ] || continue
    if ! printf '1\n' >"$online"; then
        echo "plumOS init: could not bring ${online%/online} online"
    fi
done
printf 'plumOS init: online CPUs %s\n' "$(cat /sys/devices/system/cpu/online)"

# JELOS 20240206 configures RG353M's mem suspend to use s2idle. Without
# this board quirk the vendor kernel selects deep, which did not resume on
# this device under USB power even with an RTC wakealarm.
if grep -qw s2idle /sys/power/mem_sleep &&
    printf 's2idle\n' > /sys/power/mem_sleep; then
    echo "plumOS init: JELOS RG353M mem sleep mode $(cat /sys/power/mem_sleep)"
else
    echo 'plumOS init: could not select RG353M mem sleep mode'
fi

frontend=
adb_pid=
audio_pid=
volume_keys_pid=
attempt=0
provisioned=no

clear_pmic_saved_rails() {
    local model node save_flag save0 save1
    model=$(tr -d '\000' </proc/device-tree/model)
    case "$model" in
        'Powkiddy RGB30'|'Anbernic RG353V') ;;
        *) return 0 ;;
    esac
    node=/sys/bus/i2c/devices/0-0020/of_node
    [ "$(tr '\000' '\n' <"$node/compatible")" = rockchip,rk817 ] || return 1
    save_flag=$(od -An -tx1 "$node/not-save-power-en" | tr -d ' \n')
    [ "$save_flag" = 00000001 ] || return 1

    # The BSP notifier replays nonzero POWER_EN_SAVE0 even though this DT
    # tells U-Boot not to save rail state. Discard only the two scratch bytes.
    save0=$(i2cget -f -y 0 0x20 0x99 b) || return 1
    save1=$(i2cget -f -y 0 0x20 0xa4 b) || return 1
    [ "$save0/$save1" != 0x00/0x00 ] || return 0
    i2cset -f -y 0 0x20 0x99 0x00 b &&
        i2cset -f -y 0 0x20 0xa4 0x00 b &&
        [ "$(i2cget -f -y 0 0x20 0x99 b)" = 0x00 ] &&
        [ "$(i2cget -f -y 0 0x20 0xa4 b)" = 0x00 ] || return 1
    printf 'plumOS init: cleared %s RK817 saved rail state (%s/%s)\n' "$model" "$save0" "$save1"
}

release_portmaster_mounts() {
    local tracking_file
    # An interrupted port or app can leave its bind mounts after the last
    # process using them has exited. Reuse PortMaster's target validation.
    for tracking_file in /run/plumos/portmaster/port.mounts /run/plumos/portmaster/state.mounts; do
        [ -f "$tracking_file" ] || continue
        "$PLUMOS_ROOT/bin/plumos-portmaster-mount-cleanup" "$tracking_file" || return 1
    done
}

power_action() {
    local action network marker user_marker network_stopped marker_result handoff
    action=$(cat "$runtime/power-request" 2>/dev/null) || return 0
    rm -f "$runtime/power-request"
    case "$action" in reboot|poweroff) ;; *) return 0 ;; esac
    echo "plumOS init: requested $action"
    if ! clear_pmic_saved_rails; then
        echo 'plumOS init: RK817 saved rail state could not be cleared; power action cancelled'
        return 0
    fi
    marker=$storage/provision/clean-shutdown
    user_marker=/storage/user/.plumos-clean-shutdown
    network_stopped=no
    marker_result=ok
    # The power overlay commits its request before releasing the renderer.
    # Give it a bounded handoff window so it is not itself a storage blocker.
    handoff=0
    while [ -d "$runtime/power-menu-overlay.lock" ] && [ "$handoff" -lt 30 ]; do
        sleep 0.1
        handoff=$((handoff + 1))
    done
    # A game can outlive the frontend process that launched it. Stop its
    # foreground group before unmounting the ROM and save partitions.
    if [ -x "$quiesce" ] &&
        ! "$quiesce" terminate-active "$runtime/frontend/foreground.pgid"; then
        echo 'plumOS init: foreground process could not stop; power action cancelled'
        return 0
    fi
    if [ -n "$frontend" ]; then
        kill "$frontend" 2>/dev/null || :
        for second in 1 2 3; do
            kill -0 "$frontend" 2>/dev/null || break
            sleep 1
        done
        kill -KILL "$frontend" 2>/dev/null || :
        wait "$frontend" 2>/dev/null || :
        frontend=
    fi
    attempt=0
    if [ -n "$volume_keys_pid" ]; then
        kill "$volume_keys_pid" 2>/dev/null || :
        wait "$volume_keys_pid" 2>/dev/null || :
        volume_keys_pid=
    fi
    sync
    if [ -x "$quiesce" ] &&
        ! "$quiesce" terminate-storage /storage/user /run/media/sd2; then
        echo 'plumOS init: user storage writer could not stop; power action cancelled'
        return 0
    fi
    if [ -x "$sd2_service" ] && ! "$sd2_service" stop; then
        echo 'plumOS init: could not unmount SD2; power action cancelled'
        "$sd2_service" start || :
        return 0
    fi
    # The two markers are valid only after both filesystems have been made
    # read-only. A failed transaction removes them before resuming the UI.
    if grep -qs ' /storage/user ' /proc/mounts; then
        touch "$marker" "$user_marker" || marker_result=failed
    else
        # The first provisioning reboot has not created or mounted p5 yet.
        touch "$marker" || marker_result=failed
    fi
    if [ "$marker_result" = failed ]; then
        rm -f "$marker" "$user_marker"
        "$sd2_service" start || :
        echo 'plumOS init: clean-shutdown markers unavailable; power action cancelled'
        return 0
    fi
    sync
    if grep -qs ' /storage/user ' /proc/mounts; then
        if ! mount -o remount,ro /storage/user; then
            echo 'plumOS init: could not remount user storage; power action cancelled'
            rm -f "$marker" "$user_marker"
            "$sd2_service" start || :
            return 0
        fi
    fi
    if [ -x "$PLUMOS_ROOT/bin/plumos-network-services" ]; then
        "$PLUMOS_ROOT/bin/plumos-network-services" quiesce
        network_stopped=yes
        rm -f "$runtime/network-boot-started"
    fi
    network=$PLUMOS_ROOT/bin/plumos-network-control
    if [ -x "$network" ]; then
        "$network" --wifi off || echo 'plumOS init: Wi-Fi shutdown failed'
        network_stopped=yes
    fi
    if grep -qs " $PLUMOS_ROOT overlay " /proc/mounts; then
        # A service can still be exiting, with its executable or a mapped
        # library on the runtime overlay after all of its files were closed.
        if { [ -x "$quiesce" ] && ! "$quiesce" terminate-storage "$PLUMOS_ROOT"; } ||
            ! release_portmaster_mounts ||
            ! umount "$PLUMOS_ROOT"; then
            echo 'plumOS init: could not unmount the runtime; power action cancelled'
            power_rollback "$marker" "$user_marker" "$network_stopped"
            return 0
        fi
    fi
    if [ -x "$quiesce" ] && ! "$quiesce" terminate-storage /storage; then
        echo 'plumOS init: runtime writer could not stop; power action cancelled'
        power_rollback "$marker" "$user_marker" "$network_stopped"
        return 0
    fi
    if ! mount -o remount,ro /storage; then
        echo 'plumOS init: could not remount runtime storage; power action cancelled'
        power_rollback "$marker" "$user_marker" "$network_stopped"
        return 0
    fi
    sync
    echo 'plumOS init: clean-shutdown proof committed'
    # Power operations from an ADB shell may retain a cwd on /storage.
    # Keep the transport alive until the filesystems are synchronized.
    "$payload/power" "$action"
    # A failed reboot syscall must leave PID 1 and the recovery transport alive.
    power_rollback "$marker" "$user_marker" "$network_stopped"
    echo 'plumOS init: power syscall failed'
}

power_rollback() {
    local marker user_marker network_stopped
    marker=$1 user_marker=$2 network_stopped=$3
    mount -o remount,rw /storage || :
    if grep -qs ' /storage/user ' /proc/mounts; then mount -o remount,rw /storage/user || :; fi
    rm -f "$marker" "$user_marker"
    "$sd2_service" start || :
    if [ "$network_stopped" = yes ]; then
        "$payload/mount-frontend" || :
        ( "$PLUMOS_ROOT/bin/plumos-network-control" --boot
          "$PLUMOS_ROOT/bin/plumos-network-services" start-enabled ) &
    fi
}

input_event_for_name() {
    local event
    for event in /sys/class/input/event*; do
        [ "$(cat "$event/device/name" 2>/dev/null)" = "$1" ] || continue
        printf '/dev/input/%s\n' "${event##*/}"
        return 0
    done
    return 1
}

start_recovery_network() {
    [ ! -e "$runtime/recovery-network-started" ] || return 0
    : > "$runtime/recovery-network-started"
    # This path is owned by PID 1, even when the FE launcher never starts.
    (
        "$payload/mount-frontend" || exit 0
        [ -x "$PLUMOS_ROOT/bin/plumos-network-control" ] || exit 0
        "$PLUMOS_ROOT/bin/plumos-network-control" --boot || :
        if [ -x "$PLUMOS_ROOT/bin/plumos-network-services" ]; then
            "$PLUMOS_ROOT/bin/plumos-network-services" start-enabled || :
        fi
        echo 'plumOS init: recovery network attempt finished'
    ) >>"$runtime/recovery-network.log" 2>&1 &
}

capture_recovery_snapshot() {
    mkdir -p "$storage/logs" || return 0
    {
        echo "reason=$1"
        cat /proc/cmdline
        cat /proc/mounts
        ip -4 addr show || :
        ps w || :
        dmesg | tail -120 || :
    } > "$storage/logs/boot-recovery.log" 2>&1 || :
}

mark_ready() {
    local hash
    [ ! -e "$runtime/boot-ready" ] || return 0
    [ "$provisioned" = yes ] && [ -n "$frontend" ] &&
        kill -0 "$frontend" 2>/dev/null &&
        [ -s /tmp/plumos-fe-ready ] || return 0
    [ -z "$adb_pid" ] ||
        [ "$(cat /sys/kernel/config/usb_gadget/plumos353m/UDC 2>/dev/null)" = fcc00000.dwc3 ] || return 0
    if [ -f /dev/plumos-system-active ]; then
        hash=$(cat /dev/plumos-system-active)
        [ "$(cat "$system_state/pending" 2>/dev/null)" = "$hash" ] || return 0
        printf '%s\n' "$hash" > "$system_state/healthy.new" &&
            mv "$system_state/healthy.new" "$system_state/healthy" &&
            rm "$system_state/pending" || return 0
    fi
    if [ -s "$PLUMOS_ROOT/update-state/runtime-pending.json" ]; then
        "$PLUMOS_ROOT/bin/plumos-system-update" mark-healthy >>"$PLUMOS_ROOT/logs/system-update.log" 2>&1 ||
            echo 'plumOS init: runtime update health could not be recorded'
    fi
    cut -d ' ' -f 1 /proc/uptime > "$runtime/boot-ready"
    echo 'plumOS init: frontend and selected USB policy ready'
}

# A request wakes the polling loop; shutdown itself runs outside a signal handler.
trap ':' USR1
adb_policy=$PLUMOS_ROOT/config/network/services.conf
if [ -e /dev/plumos-system-active ] || [ ! -s "$storage/provision/ready" ] ||
    ! grep -qs '^adb_enabled=0$' "$adb_policy"; then
    "$payload/start-adb" &
    adb_pid=$!
fi

if [ -x "$storage/provision/start-storage" ]; then
    result=0
    "$storage/provision/start-storage" || result=$?
    case "$result" in
        0) provisioned=yes ;;
        75)
            printf 'reboot\n' > "$runtime/power-request"
            power_action
            ;;
    esac
fi
if [ "$provisioned" = no ]; then
    echo 'plumOS init: storage is unavailable; ADB recovery remains active'
    if [ -z "$adb_pid" ]; then "$payload/start-adb" & adb_pid=$!; fi
    capture_recovery_snapshot storage-unavailable
    start_recovery_network
elif [ -x "$sd2_service" ]; then
    if [ -e "$storage/provision/clean-shutdown" ] &&
        [ -e /storage/user/.plumos-clean-shutdown ]; then
        echo 'plumOS init: previous shutdown was clean'
    else
        echo 'plumOS init: previous clean-shutdown proof unavailable'
    fi
    rm -f "$storage/provision/clean-shutdown" /storage/user/.plumos-clean-shutdown
    "$sd2_service" start || echo 'plumOS init: SD2 setup or library scan failed'
fi

while :; do
    power_action
    if [ -e "$runtime/adb-rebind-request" ]; then
        rm -f "$runtime/adb-rebind-request"
        if [ -n "$adb_pid" ]; then
            echo 'plumOS init: restarting ADB gadget after sleep'
            kill "$adb_pid" 2>/dev/null || :
            wait "$adb_pid" 2>/dev/null || :
            adb_pid=
            "$payload/start-adb" &
            adb_pid=$!
        fi
    fi
    if [ -n "$adb_pid" ] && ! kill -0 "$adb_pid" 2>/dev/null; then
        wait "$adb_pid" 2>/dev/null || :
        sleep 1
        "$payload/start-adb" &
        adb_pid=$!
    fi
    if [ -n "$audio_pid" ] && ! kill -0 "$audio_pid" 2>/dev/null; then
        wait "$audio_pid" 2>/dev/null || :
        echo 'plumOS init: audio route monitor exited; restarting'
        audio_pid=
        sleep 1
    fi
    if [ -n "$frontend" ] && ! kill -0 "$frontend" 2>/dev/null; then
        wait "$frontend"
        echo "plumOS init: frontend exited status=$?"
        frontend=
        rm -f /tmp/plumos-fe-ready
        if [ "$attempt" -eq 5 ]; then
            echo 'plumOS init: frontend restart limit; enabling ADB recovery'
            if [ -z "$adb_pid" ]; then "$payload/start-adb" & adb_pid=$!; fi
            capture_recovery_snapshot frontend-restart-limit
            start_recovery_network
        fi
        sleep 1
    fi
    if [ -z "$audio_pid" ] && [ -x "$payload/frontend/bin/plumos-rk3566-audio-route" ]; then
        "$payload/frontend/bin/plumos-rk3566-audio-route" watch &
        audio_pid=$!
    fi
    if [ "$provisioned" = yes ] && [ -z "$frontend" ] && [ "$attempt" -lt 5 ]; then
        rm -f /tmp/plumos-fe-ready
        "$payload/start-frontend" &
        frontend=$!
        attempt=$((attempt + 1))
    fi
    if [ -n "$volume_keys_pid" ] && ! kill -0 "$volume_keys_pid" 2>/dev/null; then
        wait "$volume_keys_pid" 2>/dev/null || :
        volume_keys_pid=
    fi
    if [ -z "$volume_keys_pid" ] && [ -s /tmp/plumos-fe-ready ]; then
        PLUMOS_INPUT_EVENT=$(input_event_for_name retrogame_joypad || :)
        PLUMOS_POWER_INPUT_EVENT=$(input_event_for_name 'rk805 pwrkey' || :)
        export PLUMOS_INPUT_EVENT PLUMOS_POWER_INPUT_EVENT
        "$payload/frontend/bin/plumos-volume-keys" &
        volume_keys_pid=$!
    fi
    mark_ready
    sleep 0.2
done
