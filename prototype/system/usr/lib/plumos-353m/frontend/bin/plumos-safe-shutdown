#!/bin/sh
# Accept the Bubble frontend's terminal power-action arguments.
set -eu

usage() {
    echo 'Usage: plumos-safe-shutdown --reboot | --shutdown --poweroff | --sleep [--sleep-backend mem|freeze] [--wakeup-sec N] [--dry-run]' >&2
    exit 2
}

action=
poweroff=no
dry_run=no
sleep_backend=mem
wakeup_sec=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --reboot|--shutdown|--sleep)
            [ -z "$action" ] || usage
            action=${1#--}
            ;;
        --poweroff) poweroff=yes ;;
        --no-poweroff) ;;
        --no-hold-resume) ;;
        --sleep-backend)
            [ "$#" -ge 2 ] || usage
            sleep_backend=$2
            shift
            ;;
        --wakeup-sec)
            [ "$#" -ge 2 ] || usage
            wakeup_sec=$2
            shift
            ;;
        --power-backend)
            [ "$#" -ge 2 ] && [ "$2" = auto ] || usage
            shift
            ;;
        --dry-run) dry_run=yes ;;
        *) usage ;;
    esac
    shift
done

case "$action:$poweroff" in
    reboot:no) target=reboot ;;
    shutdown:yes) target=poweroff ;;
    sleep:no) target=sleep ;;
    *) usage ;;
esac

runtime=/run/plumos-353m
if [ "$target" = sleep ]; then
    case "$sleep_backend" in mem|freeze) ;; *) usage ;; esac
    case "$wakeup_sec" in ''|*[!0-9]*) [ -z "$wakeup_sec" ] || usage ;; esac
    if [ -n "$wakeup_sec" ]; then
        [ "$wakeup_sec" -ge 1 ] && [ "$wakeup_sec" -le 3600 ] || usage
    fi
    [ -w /sys/power/state ] && grep -qw "$sleep_backend" /sys/power/state || exit 1
    if [ "$sleep_backend" = mem ] && ! grep -q '\[s2idle\]' /sys/power/mem_sleep; then
        echo 'plumOS RG353M: mem sleep requires the JELOS s2idle mode' >&2
        exit 1
    fi
    if [ "$dry_run" = yes ]; then
        printf 'result=dry-run service=plumos-init action=sleep backend=%s\n' "$sleep_backend"
        exit 0
    fi
    root=${PLUMOS_ROOT:-/storage/plumos-rk3566/frontend}
    network=$root/bin/plumos-network-control
    log=$root/logs/power-action.log
    mkdir -p "${log%/*}"
    printf 'sleep=begin backend=%s mem_sleep=%s ac=%s time=%s\n' "$sleep_backend" \
        "$(cat /sys/power/mem_sleep 2>/dev/null || echo unknown)" \
        "$(cat /sys/class/power_supply/ac/online 2>/dev/null || echo unknown)" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >>"$log"
    adb_restore=no
    if [ -e /dev/plumos-native-init ] &&
        [ -n "$(cat /sys/kernel/config/usb_gadget/plumos353m/UDC 2>/dev/null)" ]; then
        adb_restore=yes
    fi
    wifi_restore=no
    if [ -d /sys/class/net/wlan0 ] &&
        ! grep -Eq '"wifi_enabled"[[:space:]]*:[[:space:]]*(false|0)' \
          "$root/config/system/settings.json" 2>/dev/null; then
        wifi_restore=yes
    fi
    volume=$("$root/bin/plumos-volume-control" get 2>/dev/null || :)
    brightness=$("$root/bin/plumos-display-control" get 2>/dev/null || :)
    if [ "$wifi_restore" = yes ]; then
        "$network" --wifi suspend || exit 1
    fi
    if [ -n "$wakeup_sec" ]; then
        printf '0\n' > /sys/class/rtc/rtc0/wakealarm 2>/dev/null || :
        if ! printf '+%s\n' "$wakeup_sec" > /sys/class/rtc/rtc0/wakealarm; then
            [ "$wifi_restore" != yes ] || "$network" --wifi on || :
            exit 1
        fi
        printf 'sleep=wakealarm-armed seconds=%s\n' "$wakeup_sec" >>"$log"
    fi
    sync
    printf 'sleep=enter backend=%s time=%s\n' "$sleep_backend" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >>"$log"
    if ! printf '%s\n' "$sleep_backend" > /sys/power/state; then
        [ -z "$wakeup_sec" ] || printf '0\n' > /sys/class/rtc/rtc0/wakealarm || :
        [ "$wifi_restore" != yes ] || "$network" --wifi on || :
        printf 'sleep=entry-failed backend=%s\n' "$sleep_backend" >>"$log"
        exit 1
    fi
    printf 'sleep=resumed backend=%s time=%s\n' "$sleep_backend" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >>"$log"
    [ -z "$wakeup_sec" ] || printf '0\n' > /sys/class/rtc/rtc0/wakealarm || :
    case "$brightness" in ''|*[!0-9]*) ;; *) "$root/bin/plumos-display-control" apply "$brightness" || : ;; esac
    case "$volume" in ''|*[!0-9]*) ;; *) "$root/bin/plumos-volume-control" apply "$volume" || : ;; esac
    if [ "$wifi_restore" = yes ]; then
        ( "$network" --wifi on
          "$root/bin/plumos-network-services" start-enabled ) \
            >>"$runtime/sleep-network.log" 2>&1 &
    fi
    if [ "$adb_restore" = yes ]; then
        : > "$runtime/adb-rebind-request"
        kill -USR1 1
        printf 'sleep=adb-rebind-requested\n' >>"$log"
    fi
    printf 'result=resumed action=sleep backend=%s\n' "$sleep_backend"
    exit 0
fi
if [ -f "$runtime/pid1" ]; then
    if [ "$dry_run" = yes ]; then
        printf 'result=dry-run service=plumos-init action=%s\n' "$target"
        exit 0
    fi
    printf '%s\n' "$target" >"$runtime/power-request.next"
    mv "$runtime/power-request.next" "$runtime/power-request"
    kill -USR1 1
    exit $?
fi

echo 'plumOS init is unavailable' >&2
exit 1
