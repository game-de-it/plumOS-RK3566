#!/bin/sh
set -eu

root=/storage/plumos-rk3566/frontend
factory=/usr/lib/plumos-353m/frontend
work=/storage/plumos-rk3566/frontend-overlay-work

if grep -qs " $root overlay " /proc/mounts; then
    exit 0
fi

mkdir -p "$root" "$work"
# Remove only the links generated by the former launcher. Mutable state and
# user-created files already in this directory become the writable layer.
for asset in bin fonts themes share factory-defaults cores info picoarch emulator retroarch apps scraper storage-tools; do
    if [ "$(readlink "$root/$asset" 2>/dev/null || :)" = "$factory/$asset" ]; then
        rm "$root/$asset"
    fi
done
for path in "$factory"/config/frontend/*.json "$factory"/config/frontend/scraper-sources.tsv; do
    file=$root/config/frontend/${path##*/}
    if [ "$(readlink "$file" 2>/dev/null || :)" = "$path" ]; then
        rm "$file"
    fi
done

retire_test_override() {
    file=$1
    checksum=$2
    [ -f "$root/$file" ] && [ -f "$factory/$file" ] || return 0
    printf '%s  %s\n' "$checksum" "$root/$file" | sha256sum -cs || return 0
    archive=/storage/plumos-rk3566/retired-frontend-overrides/$checksum
    mkdir -p "$archive"
    mv "$root/$file" "$archive/${file##*/}"
}

# These files were installed in the writable layer during the RG353M tests.
# Migrate the fingerprinted versions so they do not shadow SYSTEM updates.
retire_test_override bin/plumos-retroarch-launch b707ffa3ee2230e250c58aff47d9917f97847dbce3c07b77599aaaf16b5dfe22
retire_test_override picoarch/bin/picoarch 12378fee83b26beead36d5bface68b0d9493b20343fe2f34d4d72207406fdb41

mount -t overlay overlay -o "lowerdir=$factory,upperdir=$root,workdir=$work" "$root"

# Keep saved RetroArch settings from the previous runtime when reusing p4.
old_config=$root/config/retroarch/retroarch-bubble.cfg
config=$root/config/retroarch/retroarch-rk3566.cfg
if [ -f "$old_config" ] && [ ! -e "$config" ]; then
    cp -p "$old_config" "$config.import" && mv -f "$config.import" "$config"
fi
