#!/bin/sh
set -eu

root=/storage/plumos-rk3566/frontend
factory=/usr/lib/plumos-353m/frontend
work=/storage/plumos-rk3566/frontend-overlay-work

if grep -qs " $root overlay " /proc/mounts; then
    exit 0
fi

mkdir -p "$root" "$work"
# Remove only the links generated by the former launcher. Mutable state and
# user-created files already in this directory become the writable layer.
for asset in bin fonts themes share factory-defaults cores info picoarch emulator retroarch apps scraper storage-tools; do
    if [ "$(readlink "$root/$asset" 2>/dev/null || :)" = "$factory/$asset" ]; then
        rm "$root/$asset"
    fi
done
for path in "$factory"/config/frontend/*.json "$factory"/config/frontend/scraper-sources.tsv; do
    file=$root/config/frontend/${path##*/}
    if [ "$(readlink "$file" 2>/dev/null || :)" = "$path" ]; then
        rm "$file"
    fi
done

mount -t overlay overlay -o "lowerdir=$factory,upperdir=$root,workdir=$work" "$root"
