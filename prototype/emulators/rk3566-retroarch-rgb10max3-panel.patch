+static unsigned drm_internal_panel_rotation(const drmModeConnector *connector)
+{
+   char model[64] = {0};
+   FILE *file;
+
+   if (connector->connector_type != DRM_MODE_CONNECTOR_DSI ||
+       drm.current_mode->hdisplay >= drm.current_mode->vdisplay)
+      return 0;
+   file = fopen("/proc/device-tree/model", "rb");
+   if (!file)
+      return 0;
+   (void)fread(model, 1, sizeof(model) - 1, file);
+   fclose(file);
+   return (strcmp(model, "Powkiddy RGB10 Max 3") == 0 ||
+           strcmp(model, "Powkiddy RGB10MAX3") == 0) ? 3 : 0;
+}
