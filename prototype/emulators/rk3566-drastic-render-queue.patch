+static inline void nds_shm_wait(uint32_t *word, uint32_t busy)
+{
+    while (__atomic_load_n(word, __ATOMIC_ACQUIRE) == busy) {
+        syscall(SYS_futex, word, FUTEX_WAIT, busy, NULL, NULL, 0);
+    }
+}
