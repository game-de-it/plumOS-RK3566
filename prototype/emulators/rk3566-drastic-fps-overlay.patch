 #if defined(GKD_MINIPLUS)
 static SDL_atomic_t drastic_menu_pending;
+static SDL_SpinLock drastic_fps_lock;
+static char drastic_fps_text[32];
+
+static bool capture_drastic_fps(const char *text)
+{
+    const char *speed = strchr(text, '%');
+    const char *frames = speed && speed[1] == ' ' ? strchr(speed + 2, '%') : NULL;
+    size_t length = frames ? (size_t)(frames - text + 1) : 0;
+    static unsigned count;
+
+    if (!length || length >= sizeof(drastic_fps_text) || frames[1] != ' ' ||
+        !strstr(frames + 2, "m/")) {
+        return false;
+    }
+    if (count++ % 60 == 0) {
+        SDL_AtomicLock(&drastic_fps_lock);
+        memcpy(drastic_fps_text, text, length);
+        drastic_fps_text[length] = '\0';
+        SDL_AtomicUnlock(&drastic_fps_lock);
+    }
+    return true;
+}
+
+static void update_drastic_fps(void)
+{
+    char text[sizeof(drastic_fps_text)];
+    SDL_Color color = { 0xcc, 0xcc, 0, 0xff };
+    SDL_Surface *glyphs;
+    SDL_Surface *surface;
+
+    SDL_AtomicLock(&drastic_fps_lock);
+    memcpy(text, drastic_fps_text, sizeof(text));
+    drastic_fps_text[0] = '\0';
+    SDL_AtomicUnlock(&drastic_fps_lock);
+    if (!text[0]) {
+        return;
+    }
+
+    glyphs = TTF_RenderUTF8_Shaded(myvideo.menu.font, text, color, (SDL_Color){0, 0, 0, 0xff});
+    if (!glyphs) {
+        return;
+    }
+    surface = SDL_ConvertSurface(glyphs, myvideo.cvt->format, 0);
+    SDL_FreeSurface(glyphs);
+    if (!surface) {
+        return;
+    }
+    SDL_FreeSurface(myvideo.fps);
+    myvideo.fps = surface;
+    myvideo.lcd.show_fps = true;
+}

 static void present_drastic_menu(void)
 {
