+static bool IsRGB10Max3Panel() {
+	char model[64]{};
+	FILE *file = std::fopen("/proc/device-tree/model", "rb");
+	if (!file)
+		return false;
+	std::fread(model, 1, sizeof(model) - 1, file);
+	std::fclose(file);
+	return std::strcmp(model, "Powkiddy RGB10 Max 3") == 0 ||
+		std::strcmp(model, "Powkiddy RGB10MAX3") == 0;
+}
