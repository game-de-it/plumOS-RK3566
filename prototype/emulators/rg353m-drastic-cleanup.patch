+    stop_drastic_child() {
+        child=$1
+        [ -n "$child" ] || return 0
+        kill -TERM "$child" 2>/dev/null || true
+        attempts=0
+        while kill -0 "$child" 2>/dev/null && [ "$attempts" -lt 10 ]; do
+            "$BB" usleep 50000
+            attempts=$((attempts + 1))
+        done
+        kill -0 "$child" 2>/dev/null &&
+            kill -KILL "$child" 2>/dev/null || true
+        wait "$child" 2>/dev/null || true
+    }
+
     restore_drastic_runtime() {
-        if [ -n "$runner_pid" ] && kill -0 "$runner_pid" 2>/dev/null; then
-            kill -TERM "$runner_pid" 2>/dev/null || true
-            runner_wait=0
-            while kill -0 "$runner_pid" 2>/dev/null &&
-                [ "$runner_wait" -lt 20 ]; do
-                "$BB" usleep 100000
-                runner_wait=$((runner_wait + 1))
-            done
-            kill -0 "$runner_pid" 2>/dev/null &&
-                kill -KILL "$runner_pid" 2>/dev/null || true
-            wait "$runner_pid" 2>/dev/null || true
-        fi
+        stop_drastic_child "$drastic_pid"
+        drastic_pid=""
+        stop_drastic_child "$runner_pid"
         runner_pid=""
         "$BB" rm -f /dev/shm/NDS_SHM /tmp/NDS_SHM
         for mount_target in $drastic_mounts; do
@@ -476,10 +482,15 @@
             cpu_snapshot_active=0
         fi
     }
+    exit_drastic() {
+        # The DRM broker can forward TERM again while the launcher unwinds.
+        trap '' HUP INT TERM
+        exit "$1"
