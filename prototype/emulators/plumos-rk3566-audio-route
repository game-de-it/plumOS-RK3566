#!/bin/sh
# RK817 speaker/headset routing. All emulator launchers use Bubble's softvol PCM.
set -eu

runtime=${PLUMOS_RUNTIME_ROOT:-/run/plumos-353m}
state=$runtime/audio/codec-route
root=${PLUMOS_ROOT:-/storage/plumos-rk3566/frontend}
settings=${PLUMOS_SYSTEM_SETTINGS_JSON:-$root/config/system/settings.json}

route() {
    local headset card previous output
    card=rockchiprk817co
    [ -e /proc/asound/"$card" ] || return 1
    headset=SPK
    for connector in /sys/class/extcon/extcon*; do
        [ "$(cat "$connector/name" 2>/dev/null)" = rk-headset ] || continue
        if grep -qx HEADPHONE=1 "$connector/state"; then
            headset=HP_NO_MIC
            if grep -qx MICROPHONE=1 "$connector/state"; then headset=HP; fi
        fi
        break
    done
    output=$(sed -n 's/.*"audio_output"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$settings" 2>/dev/null | head -n 1)
    case "$output" in
        speaker) headset=SPK ;;
        headphone) [ "$headset" != SPK ] || headset=HP_NO_MIC ;;
    esac
    previous=$(cat "$state" 2>/dev/null || :)
    [ "$headset" != "$previous" ] || return 0

    # Use the system ALSA configuration for the physical mixer.
    (unset ALSA_CONFIG_PATH; /usr/bin/amixer -q -c "$card" cset name='Playback Path' "$headset")
    mkdir -p "${state%/*}"
    printf '%s\n' "$headset" > "$state.$$"
    mv -f "$state.$$" "$state"
}

case "${1:-apply}" in
    apply) route ;;
    watch)
        while :; do
            route || :
            sleep 1
        done
        ;;
    *) exit 2 ;;
esac
