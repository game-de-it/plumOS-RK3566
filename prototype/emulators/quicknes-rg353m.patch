+++ b/nes_emu/Mapper_Namco106.cpp
@@ -215,10 +215,75 @@ void Mapper_Namco106::read_state( mapper_state_t const& in )
 	sound.load_state( sound_state );
 }

+// Mapper 210 keeps the PRG/CHR banking of the N163 but has no IRQ or audio.
+class Mapper_Namco175_340 : public Nes_Mapper {
+public:
+	Mapper_Namco175_340()
+	{
+		register_state( regs, sizeof regs );
+	}
+
+	void reset_state()
+	{
+		for ( int i = 0; i < 8; ++i )
+			regs [i] = i;
+		regs [0x0c] = cart().mirroring() & 1 ? 0x40 : 0xc0;
+		regs [0x0d] = 1;
+		regs [0x0e] = 0x3e;
+	}
+
+	void apply_mapping()
+	{
+		set_prg_bank( 0xe000, bank_8k, last_bank );
+		for ( int i = 0; i < (int) sizeof regs; ++i )
+			write( 0, 0x8000 + i * 0x800, regs [i] );
+	}
+
+	void write( nes_time_t, nes_addr_t addr, int data )
+	{
+		unsigned const reg = (addr - 0x8000) >> 11;
+		if ( reg >= sizeof regs )
+			return;
+
+		regs [reg] = data;
+		if ( reg < 8 )
+			set_chr_bank( reg * 0x400, bank_1k, data );
+		else if ( reg == 8 )
+		{
+			unsigned const ram = cart().prg_ram_size();
+			enable_sram( is_namco175() && ram, !(data & 1), ram );
+		}
+		else if ( reg >= 0x0c )
+		{
+			set_prg_bank( 0x8000 + (reg - 0x0c) * 0x2000, bank_8k, data & 0x3f );
+			if ( reg == 0x0c && !is_namco175() )
+			{
+				switch ( data >> 6 )
+				{
+					case 0: mirror_single( 0 ); break;
+					case 1: mirror_vert(); break;
+					case 2: mirror_single( 1 ); break;
+					case 3: mirror_horiz(); break;
+				}
+			}
+		}
+	}
+
+private:
+	bool is_namco175() const
+	{
+		return cart().submapper() == 1 ||
+				(cart().submapper() == 0 && cart().prg_ram_size() != 0);
+	}
+
+	uint8_t regs [15];
+};
+
 void register_namco106_mapper();
 void register_namco106_mapper()
 {
 	register_mapper<Mapper_Namco106>( 19 );
+	register_mapper<Mapper_Namco175_340>( 210 );
 }

