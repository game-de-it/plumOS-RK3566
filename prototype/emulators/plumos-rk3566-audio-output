#!/bin/sh
# One logical PCM stays open while the RG353M ALSA router changes hardware.
set -eu

root=${PLUMOS_ROOT:-/storage/plumos-rk3566/frontend}
run=${PLUMOS_RUNTIME_ROOT:-/run/plumos-353m}
directory=${PLUMOS_AUDIO_RUN_DIR:-$run/audio}
config=${PLUMOS_ALSA_CONFIG_PATH:-$directory/asound.conf}
status=${PLUMOS_AUDIO_STATUS_FILE:-$directory/output.status}
name=libasound_module_pcm_plumos_hotplug.so
libraries=$root/lib
system_libraries=${PLUMOS_PAYLOAD:-/usr/lib/plumos-353m}/frontend/lib
# The SYSTEM owns the router. An older writable runtime can hide its lib tree.
if [ -r "$system_libraries/alsa-lib/$name" ] &&
   [ -r "$system_libraries/alsa-lib-armhf/$name" ]; then
    libraries=$system_libraries
fi
plugin=$libraries/alsa-lib/$name
armhf_plugin=$libraries/alsa-lib-armhf/$name

write_config() (
    destination=$1
    library=$2
    tmp=$destination.tmp.$$
    trap 'rm -f "$tmp"' EXIT HUP INT TERM
    cat >"$tmp" <<EOF
</usr/share/alsa/alsa.conf>
# Keep the volume control on RK817 even when the USB DAC is active.
ctl.!default { type hw card $codec }

pcm_type.plumos_hotplug {
    lib "$library"
}
pcm.plumos_hotplug { type plumos_hotplug }
pcm.plumos_hotplug_plug { type plug slave.pcm "plumos_hotplug" }
pcm.plumos_softvol {
    type softvol
    slave.pcm "plumos_hotplug_plug"
    control { name "Soft Volume Master" card $codec }
    min_dB -90.0
    max_dB 0.0
    resolution 256
}
pcm.plumos_output { type plug slave.pcm "plumos_hotplug" }
pcm.plumos_pyxel { type plug slave.pcm "plumos_hotplug" }
pcm.!default { type plug slave.pcm "plumos_hotplug" }
EOF
    chmod 0644 "$tmp"
    mv -f "$tmp" "$destination"
)

prepare() {
    [ -r "$plugin" ] || { echo "Missing ALSA hotplug router: $plugin" >&2; return 1; }
    codec=$(readlink /proc/asound/rockchiprk817co 2>/dev/null || :)
    codec=${codec##*card}
    case $codec in ''|*[!0-9]*) echo 'RK817 sound card is missing' >&2; return 1 ;; esac
    [ -c "/dev/snd/pcmC${codec}D0p" ] || return 1
    "$root/bin/plumos-rk3566-audio-route" apply
    mkdir -p "$directory"
    write_config "$config" "$plugin"
    if [ -r "$armhf_plugin" ]; then
        write_config "$directory/asound-armhf.conf" "$armhf_plugin"
    fi
    # The plugin updates this status again at every physical route change.
    if [ -r /proc/asound/cards ]; then
        card=$codec
        mode=internal_stereo
        for usb in /proc/asound/card[0-9]*/usbid; do
            [ -r "$usb" ] || continue
            candidate=${usb%/usbid}
            candidate=${candidate##*card}
            [ -c "/dev/snd/pcmC${candidate}D0p" ] || continue
            selection=$(sed -n 's/.*"audio_output"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' "$root/config/system/settings.json" 2>/dev/null | head -1)
            case $selection in speaker|headphone) break ;; esac
            card=$candidate
            mode=usb_dac
            break
        done
        {
            printf 'mode=%s\nrouter=alsa_ioplug_hotplug\n' "$mode"
            printf 'card=%s\nphysical_pcm=hw:%s,0\n' "$card" "$card"
            printf 'control_card=%s\npcm=plumos_output\n' "$codec"
            printf 'alsa_config_path=%s\n' "$config"
        } >"$status.tmp.$$"
        mv -f "$status.tmp.$$" "$status"
    fi
    cat "$status"
}

case ${1:-prepare} in
    prepare) prepare ;;
    status) cat "$status" ;;
    stop) rm -f "$status" ;;
    config-path) printf '%s\n' "$config" ;;
    *) exit 2 ;;
esac
