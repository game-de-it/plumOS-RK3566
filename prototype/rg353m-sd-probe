#!/usr/bin/busybox sh
# Runs from an optional external initramfs, before JELOS touches the SD.
bb=/usr/bin/busybox
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
"$bb" mkdir -p /dev /proc /sys /flash
"$bb" mount -t devtmpfs devtmpfs /dev
"$bb" mount -t proc proc /proc
"$bb" mount -t sysfs sysfs /sys
exec >/dev/console 2>&1
printf 'plumOS: checking boot SD (read-only)...\n'

check_boot_partition() {
    "$bb" mount -t vfat -o ro UUID=0602-1646 /flash || return 1
    if [ ! -r /flash/SYSTEM ]; then
        printf 'Boot partition mounted, but /flash/SYSTEM is unreadable.\n'
        "$bb" umount /flash
        return 1
    fi
    . /rg353m-boot-trace
    plumos_trace tf1-system-readable
    "$bb" umount /flash
}

start_jelos() {
    printf 'Boot SD found; continuing JELOS startup.\n'
    printf 'plumOS SD probe: boot partition readable\n' >/dev/kmsg
    # The console is still open on /dev until JELOS redirects it again.
    "$bb" umount -l /sys /proc /dev
    exec /init
}

attempt=0
while [ "$attempt" -lt 15 ]; do
    if check_boot_partition >/dev/null 2>&1; then start_jelos; fi
    attempt=$((attempt + 1))
    "$bb" sleep 1
done

printf '\033[2J\033[HplumOS TF1 probe (RG353M)\n'
if [ -d /sys/class/mmc_host/mmc1 ]; then
    printf 'mmc1 host present'
else
    printf 'mmc1 host absent'
fi
if [ -b /dev/mmcblk1 ]; then
    printf '; mmcblk1 detected\n'
    "$bb" awk '$4 ~ /^mmcblk1(p[0-9]+)?$/ {print $3 " KiB  " $4}' /proc/partitions
else
    printf '; mmcblk1 absent\n'
fi

printf '\nTF1 kernel log (mmc1 / fe2b0000):\n'
"$bb" dmesg | "$bb" awk '
    /mmc1:|mmc_host mmc1 |mmcblk1[ :]|fe2b0000/ {
        sub(/^<[0-9]+>/, "")
        gsub(/dwmmc_rockchip fe2b0000\.dwmmc:/, "TF1 controller:")
        print
        found = 1
    }
    END { if (!found) print "No TF1 messages in kernel log" }
' | "$bb" tail -n 11
printf '\nFinal boot partition check:\n'
if check_boot_partition; then start_jelos; fi
if [ -x /plumos-recovery/adbd ]; then
    printf 'Starting USB ADB for early boot diagnostics.\n'
    PATH="/plumos-recovery/bin:$PATH" PLUMOS_PAYLOAD=/plumos-recovery \
        /plumos-recovery/start-adb >/dev/plumos-recovery.log 2>&1 &
fi
printf 'Photograph this screen, then hold Power to turn off.\n'
while :; do "$bb" sleep 60; done
